datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  name             String?
  email            String?        @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  twoFactorEnabled Boolean        @default(false)
  createdAt        DateTime       @default(now())
  accounts         Account[]
  sessions         Session[]
  deviceSessions   DeviceSession[]
  otpChallenges    OtpChallenge[]
  tasks            Task[]
  taskGroups       TaskGroup[]
  events           Event[]
  transactions     Transaction[]
  loans            Loan[]
  loanPayments     LoanPayment[]
  notifications    Notification[]
  goals            Goal[]
  notes            Note[]
  projects         Project[]
  categories       Category[]
  links            Link[]
  fileAttachments  FileAttachment[]
  categoriesSeeded Boolean        @default(false)
}

model OtpChallenge {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  email      String
  purpose    String // LOGIN_2FA | ENABLE_2FA | DISABLE_2FA | CHANGE_PASSWORD | DELETE_ACCOUNT
  codeHash   String
  tokenHash  String    @unique
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([email, purpose])
}

model DeviceSession {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  sessionId  String    @unique
  userAgent  String?
  ipAddress  String?
  label      String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  type      String // INCOME / EXPENSE
  name      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, name])
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String    @db.ObjectId
  title             String
  description       String?
  dueDate           DateTime?
  priority          String // HIGH / MEDIUM / LOW
  category          String
  status            String // PENDING / IN_PROGRESS / DONE
  isRecurring       Boolean   @default(false)
  recurringDays     String[] // Monday, Tuesday, etc.
  order             Int       @default(0)
  createdAt         DateTime  @default(now())
  groupId           String?   @db.ObjectId
  goalId            String?   @db.ObjectId
  subGoalId         String?   @db.ObjectId
  legacyChecklistId String?

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   TaskGroup? @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  goal    Goal?      @relation("TaskGoal", fields: [goalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subGoal Goal?      @relation("TaskSubGoal", fields: [subGoalId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, groupId])
  @@index([userId, goalId])
  @@index([userId, subGoalId])
  @@index([userId, legacyChecklistId])
}

model TaskGroup {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  title     String
  groupDate DateTime
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId, groupDate])
}

model Event {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  title      String
  startAt    DateTime
  endAt      DateTime
  colorLabel String // e.g. blue, red, green, purple
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  type      String // INCOME / EXPENSE
  amount    Float
  category  String
  account   String?  @default("CASH") // CASH / BANK / BKASH / NAGAD / CARD / OTHER
  note      String?
  date      DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Loan {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  userId        String        @db.ObjectId
  transactionId String?       @db.ObjectId
  direction     String // GIVEN / TAKEN
  personName    String
  principal     Float
  account       String?       @default("CASH")
  interestRate  Float         @default(0)
  note          String?
  status        String        @default("OPEN") // OPEN / PAID
  date          DateTime
  createdAt     DateTime      @default(now())
  payments      LoanPayment[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoanPayment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  loanId        String   @db.ObjectId
  userId        String   @db.ObjectId
  transactionId String?  @db.ObjectId
  amount        Float
  account       String?  @default("CASH")
  note          String?
  date          DateTime
  createdAt     DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  title        String
  description  String?
  period       String // DAILY / WEEKLY / MONTHLY / YEARLY / CUSTOM
  dueDate      DateTime?
  progress     Int       @default(0) // 0-100
  isCompleted  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  parentGoalId String?   @db.ObjectId

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentGoal   Goal?  @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subGoals     Goal[] @relation("GoalHierarchy")
  linkedTasks  Task[] @relation("TaskGoal")
  subGoalTasks Task[] @relation("TaskSubGoal")

  @@index([userId, parentGoalId])
}

// Generic cross-feature reference: e.g. a NOTE that references TRANSACTIONs / GOALs / TASKs
model Link {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  sourceType String // NOTE / GOAL / TASK / PROJECT
  sourceId   String   @db.ObjectId
  targetType String // TRANSACTION / GOAL / TASK / NOTE / LOAN / EVENT / PROJECT
  targetId   String   @db.ObjectId
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId, targetType, targetId])
}

model Project {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  title      String
  group      String    @default("General")
  status     String    @default("PLANNED") // PLANNED / ACTIVE / PAUSED / DONE
  problem    String?
  solution   String?
  features   String[]  @default([])
  techStack  String[]  @default([])
  repoUrl    String?
  liveUrl    String?
  notes      String?
  progress   Int       @default(0)
  startDate  DateTime?
  dueDate    DateTime?
  pinHash    String?
  secretSalt String?
  secretIv   String?
  secretTag  String?
  secretData String?   @db.String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Note {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  title       String?
  content     String // markdown or HTML
  attachments String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Files attached to notes or projects (binary stored in MongoDB for Vercel compatibility)
model FileAttachment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  ownerType    String // NOTE / PROJECT
  ownerId      String   @db.ObjectId
  originalName String
  mimeType     String
  size         Int
  data         Bytes
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, ownerType, ownerId])
}
